<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Больница</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Hospital.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="topbar">
            <div class="container app-nav">
                <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">✚</span><span>МЕДИКА<span class="brand-light"> · стационар</span></span></a>
                <a class="nav-current" asp-controller="Home" asp-action="Index">Пациенты</a>
                <span class="nav-caption">Информационная система больницы</span>
            </div>
        </nav>
    </header>
    <div class="container app-container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer">
        <div class="container">Учебная система управления стационаром <span>·</span> Лабораторная работа № 6</div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
